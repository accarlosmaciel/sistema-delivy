# ==============================================================================
# DELIVY GOURMET & CRAFTS — VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local e preencha com as suas credenciais reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Configurações do Projeto em Nuvem)
# Obtenha em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.seu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua-service-role-key-secreta-aqui

# ------------------------------------------------------------------------------
# 2. IDENTIFICAÇÃO DO RESTAURANTE (Multi-Loja)
# UUID padrão definido na seed inicial (supabase/seed.sql)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RESTAURANT_ID=a0000000-0000-0000-0000-000000000001

# ------------------------------------------------------------------------------
# 3. URL DA APLICAÇÃO
# Para desenvolvimento local use http://localhost:3000
# Em produção na Vercel use a URL oficial (ex: https://delivy.vercel.app)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

